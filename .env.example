# ── Main account ──────────────────────────────────────────────────────────────
# Paper trading keys (from alpaca.markets → Paper Trading)
APCA_API_KEY_ID=PKxxxxxxxxxxxxxxxxxxxxxxxx
APCA_API_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: second account (append _2, _3, etc.) ────────────────────────────
# APCA_API_KEY_ID_2=PKxxxxxxxxxxxxxxxxxxxxxxxx
# APCA_API_SECRET_KEY_2=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Data feed ─────────────────────────────────────────────────────────────────
# iex  = free tier, ~5 years depth (default)
# sip  = paid tier, full 10-year depth — requires Algo Trader Plus subscription
APCA_DATA_FEED=iex

# ── Live vs paper trading ──────────────────────────────────────────────────────
# Set to "live" to trade real money (use with extreme caution)
APCA_PAPER=true
